run = "npm run dev"
entrypoint = "server/server.js"
hidden = [".git", "node_modules", "client/node_modules", "server/node_modules"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["npm", "run", "dev"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[env]
NODE_ENV = "development"
PORT = "5000"
CLIENT_URL = "http://localhost:5173"
