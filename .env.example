# ==============================================================================
# AeroNull Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# (Retrieve from your Supabase Project Settings -> API)
# If left blank, AeroNull automatically boots in Offline Sandbox Mode with physics seed data
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI API Configuration
# (Retrieve from https://aistudio.google.com/app/apikey)
# If left blank, AeroNull utilizes the internal Quantum Neural Heuristic Core
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Vite Configuration
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
